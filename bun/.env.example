# Bearer token required on /v1, /api and /mcp. Generate: openssl rand -hex 24
FREEPI_PROXY_TOKEN=
# Optional HTTP Basic password for the dashboard and its API.
FREEPI_DASHBOARD_PASSWORD=
# Public URL used in dashboard links (TLS proxy in front).
FREEPI_PROXY_URL=https://freepi.example.com
# 1 = one access-log line per request on stdout.
FREEPI_ACCESS_LOG=0
